#!/usr/bin/env bash
#
# kernel_upgrade - compile, install and sign a mainline Linux kernel
# https://github.com/SoulInfernoDE/compile-kernel-from-source
#

# --- VERSION ---
SCRIPT_VERSION="v4.2-stable"
REPO_RAW="${KU_REPO_RAW:-https://raw.githubusercontent.com/SoulInfernoDE/compile-kernel-from-source/refs/heads/waydroid}"
UPDATE_URL="$REPO_RAW/kernel_upgrade"

set -euo pipefail

ORIG_ARGS=("$@")
SELF=$(realpath "${BASH_SOURCE[0]}")
SELF_DIR=$(dirname "$SELF")

# --- FARBEN ---
RED='\033[1;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BWHITE='\033[1;37m'
NC='\033[0m'

# --- SPRACH-ERKENNUNG ---
IS_DE=false
[[ ${LC_ALL:-${LC_MESSAGES:-${LANG:-}}} == de* ]] && IS_DE=true

# L "deutsch" "english" -> gibt den passenden Text aus
L() { if $IS_DE; then printf '%s' "$1"; else printf '%s' "${2:-$1}"; fi; }
say()  { printf '%b%s%b\n' "$BWHITE" "$(L "$@")" "$NC"; }
info() { printf '%b%s%b\n' "$YELLOW" "$(L "$@")" "$NC"; }
ok()   { printf '%b%s%b\n' "$GREEN" "$(L "$@")" "$NC"; }
err()  { printf '%b%s%b\n' "$RED" "$(L "$@")" "$NC" >&2; }
die()  { err "$@"; exit 1; }

# Maschinenlesbare Marker für die GUI (kernel_upgrade_gui)
GUI_MODE="${KU_GUI:-0}"
marker() { if [ "$GUI_MODE" = 1 ]; then printf '@@KU@@ %s\n' "$*"; fi; }
TOTAL_STAGES=7
stage() { # $1 = Nummer, $2 = de, $3 = en
    local title
    title=$(L "$2" "$3")
    marker "stage $1 $TOTAL_STAGES $title"
    printf '\n%b[%s/%s] %s%b\n' "$BWHITE" "$1" "$TOTAL_STAGES" "$title" "$NC"
}

show_help() {
    if $IS_DE; then cat <<'EOF'
Nutzung: kernel_upgrade [OPTIONEN]

Ein vollautomatisches Skript zum Kompilieren, Installieren und Signieren.

Bauen:
  --kernelversion VER      Version erzwingen (z.B. 6.12.1) oder Kanal wählen:
                           stable | longterm | mainline
  --jobs N                 Anzahl paralleler Build-Jobs (Standard: alle Kerne).
  --no-reboot              Kein Sicherheits-Neustart; baut im laufenden Custom-Kernel.
  --purge-custom           Löscht alte Custom-Kernel samt Resten.
  --with-dbg               Installiert zusätzlich das (große) Debug-Paket.
  --keep-source            Quellbaum nach erfolgreichem Build behalten.
  -y, --yes                Alle Rückfragen mit dem Standard beantworten.
  --no-autosign            Autosign-Hook nicht (nach)installieren.
  --dry-run                Zeigt nur, was passieren würde (keine Änderungen).

Verwalten:
  --list                   Installierte Kernel und verfügbare Versionen anzeigen.
  --remove VER             Einen einzelnen Custom-Kernel entfernen.
  --cleanup                Nur bereinigen (alte Custom-Kernel, Reste), kein Build.
  --signonly [VER]         Nur einen Kernel in /boot signieren.
  --installautosign        Installiert/aktualisiert den Autosign-Hook.
  --uninstallautosign      Entfernt den Autosign-Hook.
  --install-system         Installiert Skript, GUI und Icon nach ~/.scripts.
  --update                 Nur nach einer neuen Skript-Version suchen.
  --no-update              Update-Prüfung für diesen Lauf überspringen.
  --status-json            Systemstatus als JSON (für die GUI).
  --version                Zeigt die Skript-Version an.
  -h, --help               Zeigt diese Hilfe an.
EOF
    else cat <<'EOF'
Usage: kernel_upgrade [OPTIONS]

A fully automated script to compile, install, and sign.

Build:
  --kernelversion VER      Force a version (e.g. 6.12.1) or pick a channel:
                           stable | longterm | mainline
  --jobs N                 Number of parallel build jobs (default: all cores).
  --no-reboot              No safety reboot; build from the running custom kernel.
  --purge-custom           Deletes old custom kernels including leftovers.
