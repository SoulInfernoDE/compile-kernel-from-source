json_str() { local s="${1//\\/\\\\}"; s="${s//\"/\\\"}"; printf '"%s"' "$s"; }
json_bool() { if "$@" >/dev/null 2>&1; then printf true; else printf false; fi; }

print_status_json() {
    local running v first=true sb="unknown" mok="none" hook="none" free_dir free_gb
    running=$(uname -r)

    if ! is_efi; then sb="unsupported"
    elif command -v mokutil >/dev/null 2>&1; then
        if mokutil --sb-state 2>/dev/null | grep -qi 'enabled'; then sb="enabled"; else sb="disabled"; fi
    fi
    if [ -f "$SYS_MOK_DIR/MOK.der" ]; then
        mok="present"
        if command -v mokutil >/dev/null 2>&1; then
            v=$(mokutil --test-key "$SYS_MOK_DIR/MOK.der" 2>&1 || true)
            if grep -qi 'already enrolled' <<<"$v"; then mok="enrolled"
            elif grep -qi 'enrollment request' <<<"$v"; then mok="pending"; fi
        fi
    elif [ -f "$MOK_PEM" ]; then mok="present"
    fi
    if [ -f "$AUTOSIGN_PATH" ]; then
        if autosign_current; then hook="current"; else hook="outdated"; fi
    fi
    free_dir="$WORK"; [ -d "$free_dir" ] || free_dir="$CPATH"; [ -d "$free_dir" ] || free_dir="$HOME"
    free_gb=$(df -BG --output=avail "$free_dir" 2>/dev/null | tail -n 1 | tr -dc '0-9' || true)

    collect_purge_targets
    printf '{"script_version":%s,"running":%s,"running_custom":%s,"stock_kernel":%s,' \
        "$(json_str "$SCRIPT_VERSION")" "$(json_str "$running")" \
        "$(json_bool is_custom_kernel "$running")" "$(json_str "$(newest_stock_kernel)")"
    printf '"localversion":%s,"secure_boot":%s,"mok":%s,"autosign":%s,' \
        "$(json_str "$LOCALVER")" "$(json_str "$sb")" "$(json_str "$mok")" "$(json_str "$hook")"
    printf '"free_gb":%s,"cores":%s,"work_dir":%s,"pending_resume":%s,"libc_dev_custom":%s,' \
        "${free_gb:-0}" "$(nproc)" "$(json_str "$WORK")" "$(json_bool pending_resume)" \
        "$(json_bool test "$(dpkg-query -W -f '${source:Package}' linux-libc-dev 2>/dev/null || true)" = linux-upstream)"
    printf '"installed_systemwide":%s,"kernels":[' "$(json_bool test -x "$HOME/.scripts/kernel_upgrade")"
    while IFS= read -r v; do
        $first || printf ','
        first=false
        printf '{"version":%s,"custom":%s,"running":%s}' "$(json_str "$v")" \
            "$(json_bool is_custom_kernel "$v")" "$(json_bool test "$v" = "$running")"
    done < <(installed_kernels)
    printf '],"leftovers":['
    first=true
    for v in ${PURGE_VERS[@]+"${PURGE_VERS[@]}"}; do
        [ -e "/boot/vmlinuz-$v" ] && continue
        $first || printf ','
        first=false
        json_str "$v"
    done
    printf ']}\n'
}

fetch_releases() {
    local t
    for t in curl jq; do
        if ! command -v "$t" >/dev/null 2>&1; then
            info "Installiere $t..." "Installing $t..."
            sudo apt-get install -y "$t" >/dev/null
        fi
    done
    # Direkt nach dem Login (Fortsetzung nach Neustart) steht das Netzwerk oft
    # noch nicht - deshalb bis zu NET_WAIT Sekunden auf die Verbindung warten.
    local start=$SECONDS announced=false
    until RELEASES_JSON=$(curl -fsSL --connect-timeout 5 --max-time 20 https://www.kernel.org/releases.json 2>/dev/null) \
          && jq -e '.releases | length > 0' >/dev/null 2>&1 <<<"$RELEASES_JSON"; do
        if [ $((SECONDS - start)) -ge "$NET_WAIT" ]; then
            die "kernel.org ist auch nach $NET_WAIT Sekunden nicht erreichbar. Bitte Netzwerkverbindung prüfen." \
                "kernel.org is still not reachable after $NET_WAIT seconds. Please check your network connection."
        fi
        if [ "$announced" = false ]; then
            announced=true
            info "kernel.org ist nicht erreichbar - warte auf die Netzwerkverbindung (bis zu $NET_WAIT Sekunden)..." \
                 "kernel.org is not reachable - waiting for the network connection (up to $NET_WAIT seconds)..."
        fi
        sleep 3
    done
    if [ "$announced" = true ]; then ok "Netzwerkverbindung steht." "Network connection is up."; fi
}

list_kernels() {
    local v tag
    say "Installierte Kernel:" "Installed kernels:"
    while IFS= read -r v; do
        if is_custom_kernel "$v"; then tag="custom"; else tag="stock"; fi
        [ "$v" != "$(uname -r)" ] || tag="$tag, $(L "aktiv" "running")"
        printf '  %-32s [%s]\n' "$v" "$tag"
    done < <(installed_kernels)
    echo
    say "Verfügbar auf kernel.org:" "Available on kernel.org:"
    fetch_releases
    jq -r '.releases[] | select(.moniker != "linux-next") | "  \(.version)\t[\(.moniker)]\(if .iseol then " EOL" else "" end)"' <<<"$RELEASES_JSON" | expand -t 34
}

