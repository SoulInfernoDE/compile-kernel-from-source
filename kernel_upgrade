}

install_file() { # $1 = Pfad im Repo, $2 = Ziel, $3 = Modus
    local src="$SELF_DIR/$1"
    mkdir -p "$(dirname "$2")"
    if [ -f "$src" ]; then
        [ "$src" -ef "$2" ] || install -m "$3" "$src" "$2"
    elif ! { curl -fsSL --max-time 15 "$REPO_RAW/$1" -o "$2.tmp" && [ -s "$2.tmp" ] \
             && chmod "$3" "$2.tmp" && mv -f "$2.tmp" "$2"; }; then
        rm -f "$2.tmp"
        return 1
    fi
}

install_systemwide() {
