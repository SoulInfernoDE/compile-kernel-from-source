setup_autocompletion() {
    local tmp
    tmp=$(mktemp)
    cat > "$tmp" << 'EOF'
_kernel_upgrade_completions() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
