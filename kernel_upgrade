# LOGIK-PHASE
# ==============================================================================

case "$MODE" in
    autostart) autostart_resume; exit 0 ;;
    status) print_status_json; exit 0 ;;
    list) list_kernels; exit 0 ;;
    installsystem) install_systemwide; exit 0 ;;
    remove) remove_single_kernel; exit 0 ;;
    cleanup)
        start_sudo
        if pending_resume; then cancel_pending_resume; fi
        purge_old_custom_kernels
        exit 0 ;;
    uninstallautosign) start_sudo; uninstall_autosign; exit 0 ;;
    installautosign) start_sudo; manage_keys; manage_autosign force; exit 0 ;;
    sign) start_sudo; manual_sign; exit 0 ;;
esac

start_sudo
[ "$DRY_RUN" = true ] || [ ! -f "$COMPLETION_PATH" ] || setup_autocompletion

if [ "$RESUMED_FROM_REBOOT" = true ]; then
    handle_resume
elif pending_resume; then
    # Ein früherer Lauf wurde vor dem Neustart abgebrochen: Autostart-Eintrag und
    # der einmalige GRUB-Booteintrag würden sonst beim nächsten Start zuschlagen.
    info "Entferne Reste eines abgebrochenen Neustart-Vorgangs..." "Removing leftovers of an aborted reboot sequence..."
    cancel_pending_resume
fi

# CRITICAL ENVIRONMENT-CHECK: Neustart, wenn wir NICHT in einem offiziellen Kernel sind
if [ "$RESUMED_FROM_REBOOT" = false ] && [ "$NO_REBOOT" = false ] && is_custom_kernel "$(uname -r)"; then
    handle_one_time_reboot
    exit 0
fi

if [ "$PURGE_CUSTOM" = true ] && [ "$RESUMED_FROM_REBOOT" = false ]; then
    purge_old_custom_kernels
fi

# ==============================================================================
# AB HIER ERST: Netzwertraffic & Kompilier-Infrastruktur
# ==============================================================================

stage 1 "Version ermitteln & Abhängigkeiten" "Resolve version & dependencies"

if [ "$DRY_RUN" = true ] && ! { command -v curl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; }; then
    die "Für --dry-run werden curl und jq benötigt." "--dry-run needs curl and jq."
fi
fetch_releases

EXPLICIT_VERSION=false
case "$MANUAL_KERNEL_VERSION" in
    ""|stable|latest) KERNEL_VERSION=$(jq -r '.latest_stable.version' <<<"$RELEASES_JSON") ;;
    longterm|lts) KERNEL_VERSION=$(jq -r 'first(.releases[] | select(.moniker=="longterm") | .version)' <<<"$RELEASES_JSON") ;;
    mainline|rc) KERNEL_VERSION=$(jq -r 'first(.releases[] | select(.moniker=="mainline") | .version)' <<<"$RELEASES_JSON") ;;
    *) KERNEL_VERSION="$MANUAL_KERNEL_VERSION"; EXPLICIT_VERSION=true ;;
esac

valid_kernel_version() { [[ $1 =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?(-rc[0-9]+)?$ ]]; }
kernel_present() { # $1 = Release
    [ "$(uname -r)" = "$1" ] || [[ "$(dpkg-query -W -f '${db:Status-Abbrev}' "linux-image-$1" 2>/dev/null || true)" == ii* ]]
}

valid_kernel_version "$KERNEL_VERSION" || die "Ungültige Kernel-Version: $KERNEL_VERSION" "Invalid kernel version: $KERNEL_VERSION"

if kernel_present "$(expected_release "$KERNEL_VERSION")"; then
    info "Kernel $KERNEL_VERSION ist bereits gebaut/installiert!" "Kernel $KERNEL_VERSION is already built/installed!"
    if [ "$EXPLICIT_VERSION" = true ]; then
        ask_yn "$(L "Trotzdem neu bauen?" "Rebuild anyway?")" y || exit 0
    elif [ "$ASSUME_YES" = true ] || [ ! -t 0 ]; then
        ok "Das System ist aktuell - nichts zu tun." "The system is up to date - nothing to do."
        marker "uptodate"
        exit 0
    else
        say "Wähle eine alternative Version oder tippe eine ein:" "Select an alternative version or type one manually:"
        mapfile -t ALTS < <(jq -r --arg cur "$KERNEL_VERSION" \
            '[.releases[] | select(.moniker=="stable" or .moniker=="longterm" or .moniker=="mainline") | select(.version != $cur)][:5][] | "\(.version) \(.moniker)"' <<<"$RELEASES_JSON")
        for i in "${!ALTS[@]}"; do printf '  [%s] %-12s (%s)\n' "$((i+1))" "${ALTS[$i]%% *}" "${ALTS[$i]##* }"; done
        echo "  [r] $(L "$KERNEL_VERSION neu bauen" "Rebuild $KERNEL_VERSION")"
        echo "  [q] $(L "Abbrechen" "Quit")"
        read -r -p "$(L "Auswahl oder Version (z.B. 6.12.1)" "Selection or version (e.g. 6.12.1)"): " choice
        case "$choice" in
            q|Q|"") exit 0 ;;
            r|R) ;;
            *)
                if [[ $choice =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#ALTS[@]}" ]; then
                    KERNEL_VERSION="${ALTS[$((choice-1))]%% *}"
                else
                    KERNEL_VERSION="$choice"
                fi ;;
        esac
        valid_kernel_version "$KERNEL_VERSION" || die "Ungültige Kernel-Version: $KERNEL_VERSION" "Invalid kernel version: $KERNEL_VERSION"
    fi
fi

EXPECT_REL=$(expected_release "$KERNEL_VERSION")
MAJOR="${KERNEL_VERSION%%.*}"
DL_URL=$(jq -r --arg v "$KERNEL_VERSION" 'first(.releases[] | select(.version==$v) | .source // empty) // empty' <<<"$RELEASES_JSON")
if [ -z "$DL_URL" ]; then
    if [[ $KERNEL_VERSION == *-rc* ]]; then
        DL_URL="https://git.kernel.org/torvalds/t/linux-${KERNEL_VERSION}.tar.gz"
    else
        DL_URL="https://cdn.kernel.org/pub/linux/kernel/v${MAJOR}.x/linux-${KERNEL_VERSION}.tar.xz"
    fi
fi
TARBALL="${DL_URL##*/}"
say "Nutze Version: $KERNEL_VERSION  ->  $EXPECT_REL" "Using version: $KERNEL_VERSION  ->  $EXPECT_REL"

if [ "$DRY_RUN" = true ]; then
    say "Download: $DL_URL" "Download: $DL_URL"
    say "Build-Verzeichnis: $WORK (make -j$CPUCORES bindeb-pkg)" "Build directory: $WORK (make -j$CPUCORES bindeb-pkg)"
    ok "Dry-Run beendet - es wurde nichts verändert." "Dry run finished - nothing was changed."
    exit 0
fi

# --- Build-Verzeichnis ---
# Ein eigenes Verzeichnis statt ~/Downloads, damit beim Aufräumen garantiert
# nur Dateien dieses Skripts gelöscht werden.
if [ -d "$WORK" ] && [ ! -f "$WORK/$WORK_MARKER" ] && [ -n "$(ls -A "$WORK")" ]; then
    die "$WORK existiert bereits und gehört nicht zu kernel_upgrade. Bitte KU_BUILD_DIR setzen." \
        "$WORK already exists and does not belong to kernel_upgrade. Please set KU_BUILD_DIR."
fi
mkdir -p "$WORK"
touch "$WORK/$WORK_MARKER"

find_debs() { # setzt DEB_IMAGE, DEB_HEADERS, DEB_DBG für Release $1
    DEB_IMAGE=$(ls -t "$WORK"/linux-image-"$1"_*.deb 2>/dev/null | head -n 1 || true)
    DEB_HEADERS=$(ls -t "$WORK"/linux-headers-"$1"_*.deb 2>/dev/null | head -n 1 || true)
    DEB_DBG=$(ls -t "$WORK"/linux-image-"$1"-dbg_*.deb 2>/dev/null | head -n 1 || true)
}

SKIP_BUILD=false
find_debs "$EXPECT_REL"
if [ -n "$DEB_IMAGE" ] && [ -n "$DEB_HEADERS" ]; then
    info "Fertige Kernel-Pakete für $EXPECT_REL gefunden." "Found finished kernel packages for $EXPECT_REL."
    if ask_yn "$(L "Build überspringen und nur installieren & signieren?" "Skip build and only install & sign?")" y; then
        SKIP_BUILD=true
    fi
fi

KREL="$EXPECT_REL"
BUILD_SECONDS=0

if [ "$SKIP_BUILD" = false ]; then
    info "Installiere Abhängigkeiten..." "Installing dependencies..."
    REQ_PKGS=(build-essential bc bison flex libssl-dev libelf-dev libdw-dev dwarves fakeroot dpkg-dev debhelper
              kmod cpio rsync zstd xz-utils gawk python3 git patch patchutils libncurses-dev openssl
              sbsigntool mokutil jq curl wget ca-certificates dkms libudev-dev libpci-dev libiberty-dev
              autoconf cmake)
    INSTALLED=$(dpkg-query -W -f '${Package} ${db:Status-Abbrev}\n' "${REQ_PKGS[@]}" 2>/dev/null | awk '$2 ~ /^ii/ { print $1 }' || true)
    TO_INSTALL=()
    for p in "${REQ_PKGS[@]}"; do
        grep -qxF "$p" <<<"$INSTALLED" && continue
        if apt-cache show "$p" >/dev/null 2>&1; then
            TO_INSTALL+=("$p")
        else
            info "Paket $p ist in den Paketquellen nicht verfügbar - übersprungen." "Package $p is not available in the repositories - skipped."
        fi
    done
    if [ "${#TO_INSTALL[@]}" -gt 0 ]; then
        say "  ${TO_INSTALL[*]}"
        sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y "${TO_INSTALL[@]}" > /dev/null \
            || die "Fehler: Abhängigkeiten konnten nicht installiert werden." "Error: dependencies could not be installed."
    fi
    for t in gcc make bc bison flex fakeroot dpkg-buildpackage wget tar; do
        command -v "$t" >/dev/null 2>&1 || die "Fehler: Benötigtes Werkzeug fehlt: $t" "Error: required tool missing: $t"
    done

    FREE_GB=$(df -BG --output=avail "$WORK" | tail -n 1 | tr -dc '0-9')
    if [ "${FREE_GB:-0}" -lt 45 ]; then
        info "Nur ${FREE_GB} GB frei in $WORK - ein Build mit Debug-Infos braucht bis zu 45 GB." \
             "Only ${FREE_GB} GB free in $WORK - a build with debug info needs up to 45 GB."
        ask_yn "$(L "Trotzdem fortfahren?" "Continue anyway?")" y || exit 1
    fi

    # --- Download ---
    stage 2 "Kernel-Quellen herunterladen" "Download kernel sources"
    # Alles außer dem passenden Tarball stammt aus früheren Läufen
    find "$WORK" -mindepth 1 -maxdepth 1 ! -name "$WORK_MARKER" ! -name "$TARBALL" -exec rm -rf {} +
    wget -c -q --show-progress -P "$WORK" "$DL_URL"

    if [[ $DL_URL == https://cdn.kernel.org/* ]]; then
        WANT_SUM=$(curl -fsSL --max-time 30 "${DL_URL%/*}/sha256sums.asc" 2>/dev/null | awk -v f="$TARBALL" '$2 == f { print $1 }' || true)
        if [ -n "$WANT_SUM" ]; then
            GOT_SUM=$(sha256sum "$WORK/$TARBALL" | cut -d' ' -f1)
            if [ "$WANT_SUM" != "$GOT_SUM" ]; then
                rm -f "$WORK/$TARBALL"
                die "Prüfsumme von $TARBALL stimmt nicht! Datei gelöscht - bitte erneut starten." \
                    "Checksum mismatch for $TARBALL! File deleted - please run again."
            fi
            ok "SHA256-Prüfsumme stimmt." "SHA256 checksum verified."
        else
            info "Keine Prüfsumme für $TARBALL gefunden - überspringe Prüfung." "No checksum found for $TARBALL - skipping verification."
        fi
    fi

    info "Entpacke $TARBALL..." "Extracting $TARBALL..."
    tar -xf "$WORK/$TARBALL" -C "$WORK"
    SRC_DIR="$WORK/linux-${KERNEL_VERSION}"
    [ -d "$SRC_DIR" ] || die "Quellverzeichnis $SRC_DIR fehlt nach dem Entpacken." "Source directory $SRC_DIR missing after extraction."
    cd "$SRC_DIR"

    # --- Konfiguration ---
    stage 3 "Kernel konfigurieren" "Configure kernel"
    # Basis ist immer die Konfiguration des Distributions-Kernels
    BASE_CONFIG=""
    STOCK=$(newest_stock_kernel)
    if [ -n "$STOCK" ] && [ -f "/boot/config-$STOCK" ]; then BASE_CONFIG="/boot/config-$STOCK"
    elif [ -f "/boot/config-$(uname -r)" ]; then BASE_CONFIG="/boot/config-$(uname -r)"
    fi
    if [ -n "$BASE_CONFIG" ]; then
        say "Basis-Konfiguration: $BASE_CONFIG" "Base configuration: $BASE_CONFIG"
        cp "$BASE_CONFIG" .config
    elif [ -f /proc/config.gz ]; then
        zcat /proc/config.gz > .config
    else
        die "Keine Kernel-Konfiguration als Basis gefunden." "No kernel configuration found to start from."
    fi
    make olddefconfig

    if [ -f "$USER_FRAGMENT" ]; then
        say "Nutze eigenes Fragment: $USER_FRAGMENT" "Using custom fragment: $USER_FRAGMENT"
        cp "$USER_FRAGMENT" .config-fragment
    else
        cat > .config-fragment <<EOF
#
# Certificates for signature checking
#
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_LOCALVERSION="$LOCALVER"
#
# Android
#
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder,binderfs"
CONFIG_ANDROID_BINDER_IPC_SELFTEST=y
# end of Android
#
# Performance monitoring
#
CONFIG_PERF_EVENTS_AMD_POWER=m
#
# Misc devices
#
CONFIG_NTSYNC=y
EOF
    fi
    ./scripts/kconfig/merge_config.sh .config .config-fragment
    make olddefconfig

    # Neuere Kernel legen die .config bereits selbst ins Header-Paket
    if ! grep -q '\.config' scripts/package/install-extmod-build 2>/dev/null \
       && grep -q '^install_kernel_headers () {' "$BUILDDEB_FILE" 2>/dev/null \
       && ! grep -qF "$MARKER" "$BUILDDEB_FILE"; then
        sed -i "/^install_kernel_headers () {/,/^}/ s|^}|    $MARKER\n    [ -f .config ] \&\& cp .config \"\$pdir/usr/src/linux-headers-\${version}/.config\"\n}|" "$BUILDDEB_FILE"
    fi

    # --- Build ---
    stage 4 "Kernel $KREL kompilieren (-j$CPUCORES)" "Compile kernel $KREL (-j$CPUCORES)"
    SECONDS=0
    if ! nice make -j"$CPUCORES" bindeb-pkg 2>&1 | tee "$WORK/build.log"; then
        err "Build fehlgeschlagen. Vollständiges Protokoll: $WORK/build.log" "Build failed. Full log: $WORK/build.log"
        grep -nE '(error:|Error [0-9]+|\*\*\*)' "$WORK/build.log" | tail -n 15 >&2 || true
        exit 1
    fi
    BUILD_SECONDS=$SECONDS
    # Der endgültige Release-Name (inkl. Suffix) steht erst nach dem Build fest
    if [ -s include/config/kernel.release ]; then KREL=$(cat include/config/kernel.release); fi
    cd "$WORK"
    find_debs "$KREL"
fi

[ -n "$DEB_IMAGE" ] || die "Kein Kernel-Paket für $KREL in $WORK gefunden." "No kernel package for $KREL found in $WORK."

# --- Installation ---
stage 5 "Kernel installieren" "Install kernel"
SIGNING=false
if is_efi || [ -f "$MOK_PRIV" ]; then
    command -v sbsign >/dev/null 2>&1 || sudo apt-get install -y sbsigntool mokutil >/dev/null
    manage_keys
    manage_autosign
    SIGNING=true
else
    info "Kein UEFI-System - Signierung wird übersprungen." "Not a UEFI system - skipping signing."
fi

# linux-libc-dev wird bewusst NICHT installiert: es würde das Paket der Distribution ersetzen.
DEBS=("$DEB_IMAGE")
[ -z "$DEB_HEADERS" ] || DEBS+=("$DEB_HEADERS")
if [ "$WITH_DBG" = true ] && [ -n "$DEB_DBG" ]; then DEBS+=("$DEB_DBG"); fi
sudo dpkg -i "${DEBS[@]}"

stage 6 "Kernel signieren" "Sign kernel"
if [ "$SIGNING" = true ]; then
    sign_kernel "$KREL"
else
    info "Übersprungen." "Skipped."
fi

# --- Aufräumen ---
stage 7 "Aufräumen" "Clean up"
if [ "$KEEP_SOURCE" = false ]; then
    find "$WORK" -mindepth 1 -maxdepth 1 -type d -name 'linux-*' -exec rm -rf {} +
    rm -f "$WORK"/linux-*.tar.* "$WORK"/linux-libc-dev_*.deb "$WORK"/linux-upstream_*
    if [ "$WITH_DBG" = false ]; then rm -f "$WORK"/linux-image-*-dbg_*.deb; fi
    ok "Quellbaum entfernt. Pakete liegen in $WORK." "Source tree removed. Packages are in $WORK."
fi
clean_legacy_artifacts

echo
ok "Kernel Upgrade erfolgreich abgeschlossen!" "Kernel upgrade completed successfully!"
say "Installiert: $KREL" "Installed: $KREL"
if [ "$BUILD_SECONDS" -gt 0 ]; then
    say "Build-Dauer: $((BUILD_SECONDS / 60)) min $((BUILD_SECONDS % 60)) s" "Build time: $((BUILD_SECONDS / 60)) min $((BUILD_SECONDS % 60)) s"
fi
if [ "$MOK_PENDING" = true ]; then
    info "WICHTIG: Beim nächsten Neustart im blauen MOK-Manager 'Enroll MOK' wählen und das Einmal-Passwort eingeben!" \
         "IMPORTANT: on the next reboot select 'Enroll MOK' in the blue MOK manager and enter the one-time password!"
    marker "mok-pending"
fi
info "Starte das System neu, um den neuen Kernel zu nutzen." "Reboot the system to use the new kernel."
marker "done $KREL"
