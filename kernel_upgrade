# --- PARAMETER-STEUERUNG ---
MODE="build"
PURGE_CUSTOM=false
RESUMED_FROM_REBOOT=false
NO_REBOOT=false
NO_UPDATE=false
ASSUME_YES=false
DRY_RUN=false
WITH_DBG=false
KEEP_SOURCE=false
WANT_AUTOSIGN=true
MANUAL_KERNEL_VERSION=""
SIGN_VERSION=""
REMOVE_VERSION=""
CPUCORES=$(nproc)

need_arg() { [[ -n "${2:-}" && $2 != --* ]] || die "Fehler: $1 benötigt ein Argument." "Error: $1 needs an argument."; }

while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--help) show_help; exit 0 ;;
    --version) echo "kernel_upgrade version $SCRIPT_VERSION"; exit 0 ;;
    --signonly)
      MODE="sign"
      if [[ -n "${2:-}" && $2 != -* ]]; then SIGN_VERSION="$2"; shift; fi
      shift ;;
    --installautosign) MODE="installautosign"; shift ;;
    --uninstallautosign) MODE="uninstallautosign"; shift ;;
    --install-system) MODE="installsystem"; shift ;;
    --status-json) MODE="status"; shift ;;
    --list) MODE="list"; shift ;;
    --cleanup) MODE="cleanup"; shift ;;
    --update) MODE="update"; shift ;;
    --autostart-resume) MODE="autostart"; shift ;;
    --remove) need_arg "$1" "${2:-}"; MODE="remove"; REMOVE_VERSION="$2"; shift 2 ;;
    --purge-custom) PURGE_CUSTOM=true; shift ;;
    --resumed) RESUMED_FROM_REBOOT=true; shift ;;
    --no-reboot) NO_REBOOT=true; shift ;;
    --no-update) NO_UPDATE=true; shift ;;
    -y|--yes) ASSUME_YES=true; shift ;;
    --dry-run) DRY_RUN=true; shift ;;
    --with-dbg) WITH_DBG=true; shift ;;
    --keep-source) KEEP_SOURCE=true; shift ;;
    --no-autosign) WANT_AUTOSIGN=false; shift ;;
    --kernelversion) need_arg "$1" "${2:-}"; MANUAL_KERNEL_VERSION="$2"; shift 2 ;;
    --jobs)
      need_arg "$1" "${2:-}"
      [[ $2 =~ ^[1-9][0-9]*$ ]] || die "Fehler: --jobs erwartet eine Zahl." "Error: --jobs expects a number."
      CPUCORES="$2"; shift 2 ;;
    *) err "Unbekannte Option: $1" "Unknown option: $1"; echo; show_help; exit 2 ;;
  esac
done

# Das Skript holt sich Root-Rechte selbst per sudo. Wird es komplett als root
# gestartet, zeigen $HOME, Schlüssel und Build-Verzeichnis auf /root.
if [ "$EUID" -eq 0 ] && [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    exec sudo -u "$SUDO_USER" -H -- "$SELF" ${ORIG_ARGS[@]+"${ORIG_ARGS[@]}"}
fi

# --- KONFIGURATION ---
CPATH="$HOME/Downloads"
WORK="${KU_BUILD_DIR:-$CPATH/kernel_upgrade}"
WORK_MARKER=".kernel_upgrade_workdir"
LOCALVER="${KU_LOCALVERSION:--waydroid}"
USER_MOK_DIR="$HOME/.mok_keys"
SYS_MOK_DIR="/var/lib/shim-signed/mok"
MOK_PRIV="$USER_MOK_DIR/MOK.priv"
MOK_PEM="$USER_MOK_DIR/MOK.pem"
MOK_DER="$USER_MOK_DIR/MOK.der"
AUTOSIGN_PATH="/etc/kernel/postinst.d/sign_kernel_images"
AUTOSIGN_MARKER="kernel_upgrade-autosign v2"
COMPLETION_PATH="/etc/bash_completion.d/kernel_upgrade"
BUILDDEB_FILE="scripts/package/builddeb"
MARKER="# Include .config in headers package"
GRUB_CFG="${KU_GRUB_CFG:-/boot/grub/grub.cfg}"
GRUB_ENV="/boot/grub/grubenv"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kernel_upgrade"
RESUME_ARGS_FILE="$STATE_DIR/resume.args"
RESUME_UI_FILE="$STATE_DIR/resume.ui"
AUTOSTART_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/kernel_upgrade_resume.desktop"
USER_FRAGMENT="${XDG_CONFIG_HOME:-$HOME/.config}/kernel_upgrade/config-fragment"
GUI_NAME="kernel_upgrade_gui"
ICON_NAME="kernel_upgrade"
ICON_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/scalable/apps"
DESKTOP_FILE="${XDG_DATA_HOME:-$HOME/.local/share}/applications/kernel_upgrade.desktop"
MOK_PENDING=false
NET_WAIT="${KU_NET_WAIT:-60}"

# ==============================================================================
# HILFSFUNKTIONEN
# ==============================================================================

# run CMD... -> führt aus, im --dry-run wird nur angezeigt
run() {
    if [ "$DRY_RUN" = true ]; then
        printf '%b[dry-run]%b %s\n' "$YELLOW" "$NC" "$*"
    else
        "$@"
    fi
}

# ask_yn "Frage" y|n -> Rückgabe 0 bei Ja. Standard gilt bei --yes und ohne Terminal.
ask_yn() {
    local def="$2" ans=""
    if [ "$ASSUME_YES" = true ] || [ ! -t 0 ]; then
        ans="$def"
    else
        read -r -p "$1 ($([ "$def" = y ] && echo "Y/n" || echo "y/N")): " ans || ans=""
        ans="${ans:-$def}"
    fi
    [[ $ans =~ ^[yYjJ] ]]
}

SUDO_PID=""
start_sudo() {
    if [ -n "$SUDO_PID" ] || [ "$DRY_RUN" = true ]; then return 0; fi
    sudo -v
    ( while sleep 50; do sudo -n -v 2>/dev/null || exit 0; done ) </dev/null >/dev/null 2>&1 &
    SUDO_PID=$!
}
cleanup_on_exit() {
    if [ -n "$SUDO_PID" ]; then kill "$SUDO_PID" 2>/dev/null || true; fi
}
trap cleanup_on_exit EXIT

# Versionsvergleich: "v3.6-stable" -> "3.6"
ver_num() { local v="${1#v}"; printf '%s' "${v%%-*}"; }
ver_gt() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]; }

valid_release() { [[ $1 =~ ^[0-9]+\.[0-9]+[A-Za-z0-9.+~_-]*$ ]]; }

# --- ATOMARE AUTO-UPDATE FUNKTION ---
update_companion() { # $1 = Pfad im Repo, $2 = Zieldatei (nur wenn bereits installiert)
    local tmp
    [ -f "$2" ] && [ -w "$2" ] || return 0
    tmp=$(mktemp "$(dirname "$2")/.ku_update.XXXXXX") || return 0
    if curl -fsSL --max-time 10 "$REPO_RAW/$1" -o "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
        chmod --reference="$2" "$tmp" 2>/dev/null || true
        mv -f "$tmp" "$2"
    else
        rm -f "$tmp"
    fi
}

check_for_updates() { # $1 = "verbose" für --update
    local verbose="${1:-}" tmp remote
    if [ -n "${KU_UPDATED:-}" ]; then return 0; fi
    if ! command -v curl >/dev/null 2>&1; then
        [ -z "$verbose" ] || err "curl fehlt - Update-Prüfung nicht möglich." "curl is missing - cannot check for updates."
        return 0
    fi
    if [ -e "$SELF_DIR/.git" ]; then
        [ -z "$verbose" ] || info "Git-Checkout erkannt - Updates bitte per 'git pull'." "Git checkout detected - please update via 'git pull'."
        return 0
    fi
    if [ ! -w "$SELF" ] || [ ! -w "$SELF_DIR" ]; then
        [ -z "$verbose" ] || err "Keine Schreibrechte auf $SELF." "No write permission for $SELF."
        return 0
    fi

    # Temp-Datei im selben Verzeichnis, damit das mv wirklich atomar ist
    tmp=$(mktemp "$SELF_DIR/.kernel_upgrade.XXXXXX") || return 0
    if ! curl -fsSL --max-time 5 "$UPDATE_URL" -o "$tmp" 2>/dev/null; then
        rm -f "$tmp"
        [ -z "$verbose" ] || err "Update-Server nicht erreichbar: $UPDATE_URL" "Update server unreachable: $UPDATE_URL"
        return 0
    fi

    remote=$(grep -m 1 '^SCRIPT_VERSION=' "$tmp" | cut -d'"' -f2 || true)
    if [ -z "$remote" ] || ! ver_gt "$(ver_num "$remote")" "$(ver_num "$SCRIPT_VERSION")"; then
        rm -f "$tmp"
        [ -z "$verbose" ] || ok "Skript ist aktuell ($SCRIPT_VERSION)." "Script is up to date ($SCRIPT_VERSION)."
        return 0
    fi

    info "Update gefunden: $remote (Aktuell: $SCRIPT_VERSION)" "Update found: $remote (current: $SCRIPT_VERSION)"
    if ! head -n 1 "$tmp" | grep -q '^#!.*bash' || ! bash -n "$tmp" 2>/dev/null; then
        rm -f "$tmp"
        err "Heruntergeladene Datei ist ungültig. Fahre mit der aktuellen Version fort..." "Downloaded file is invalid. Continuing with the current version..."
        return 0
    fi

    chmod --reference="$SELF" "$tmp" 2>/dev/null || chmod 755 "$tmp"
    mv -f "$tmp" "$SELF"
    update_companion "$GUI_NAME" "$SELF_DIR/$GUI_NAME"
    update_companion "assets/$ICON_NAME.svg" "$ICON_DIR/$ICON_NAME.svg"
    ok "Update erfolgreich! Skript startet neu..." "Update successful! Restarting script..."
    KU_UPDATED=1 exec "$SELF" ${ORIG_ARGS[@]+"${ORIG_ARGS[@]}"}
}

case "$MODE" in
    status|autostart) ;;
    update) check_for_updates verbose; exit 0 ;;
    *)
        if [ "$NO_UPDATE" = false ] && [ "${KU_NO_UPDATE:-0}" != 1 ] && [ "$RESUMED_FROM_REBOOT" = false ]; then
            check_for_updates
        fi ;;
esac

# ==============================================================================
# KERNEL-ERKENNUNG
# ==============================================================================

# Selbst gebaute Kernel (make bindeb-pkg) tragen das Quellpaket "linux-upstream".
# Das ist zuverlässiger als auf Namensendungen wie -generic oder -amd64 zu raten.
is_custom_kernel() { # $1 = Kernel-Release
    local pkg src
    pkg=$(dpkg-query -S "/boot/vmlinuz-$1" 2>/dev/null | head -n 1 | cut -d: -f1 || true)
    [ -n "$pkg" ] || return 0
    src=$(dpkg-query -W -f '${source:Package}' "$pkg" 2>/dev/null || true)
    [ "$src" = "linux-upstream" ]
}

installed_kernels() { # neueste zuerst
    local f
    for f in /boot/vmlinuz-*; do
        [ -e "$f" ] || continue
        printf '%s\n' "${f#/boot/vmlinuz-}"
    done | sort -rV
}

newest_stock_kernel() {
    local v
    while IFS= read -r v; do
        if ! is_custom_kernel "$v"; then printf '%s\n' "$v"; return 0; fi
    done < <(installed_kernels)
    return 0
}

custom_packages() { # alle (auch halb entfernten) Pakete aus eigenen Builds
    dpkg-query -W -f '${db:Status-Abbrev}\t${Package}\t${source:Package}\n' 'linux-*' 2>/dev/null \
        | awk -F'\t' '$3 == "linux-upstream" && $1 !~ /^un/ { print $2 }' || true
}

path_owned() { dpkg-query -S "$1" >/dev/null 2>&1 || dpkg-query -S "/usr$1" >/dev/null 2>&1; }

# "7.2" -> "7.2.0-waydroid", "7.3-rc6" -> "7.3.0-rc6-waydroid"
expected_release() {
    local v="$1" base rc=""
    base="${v%%-*}"
    [ "$base" = "$v" ] || rc="-${v#*-}"
    [[ $base =~ ^[0-9]+\.[0-9]+$ ]] && base="$base.0"
    printf '%s%s%s' "$base" "$rc" "$LOCALVER"
}

# Sucht den GRUB-Eintrag über die stabile menuentry-ID statt über den Titel.
find_grub_entry() { # $1 = Kernel-Release -> "submenu-id>eintrag-id"
    local reader=(cat)
    if [ ! -r "$GRUB_CFG" ]; then
        if [ "$DRY_RUN" = true ]; then return 0; fi
        reader=(sudo cat)
    fi
    "${reader[@]}" "$GRUB_CFG" | awk -v ver="$1" '
        function entry_id(line,   s) {
            if (match(line, /menuentry_id_option \047[^\047]+\047/)) {
                s = substr(line, RSTART, RLENGTH)
                sub(/^[^\047]*\047/, "", s); sub(/\047$/, "", s)
                return s
            }
            return ""
        }
        /^submenu /  { sub_id = entry_id($0); next }
        /^}/         { sub_id = ""; next }
        /^[ \t]*menuentry / {
            id = entry_id($0)
            if (!found && index(id, "gnulinux-" ver "-advanced-") == 1) {
                found = (sub_id != "" ? sub_id ">" : "") id
            }
        }
        END { if (found) print found }'
}

# ==============================================================================
# BEREINIGUNG
# ==============================================================================

PURGE_PKGS=()
PURGE_VERS=()
SKIPPED_RUNNING=false

collect_purge_targets() { # $1 = optional: nur dieses Release
    local only="${1:-}" running p v d
    local -A seen=()
    running=$(uname -r)
    PURGE_PKGS=(); PURGE_VERS=(); SKIPPED_RUNNING=false

    while IFS= read -r p; do
        [ -n "$p" ] || continue
        case "$p" in
            linux-image-*) v="${p#linux-image-}"; v="${v%-dbg}" ;;
            linux-headers-*) v="${p#linux-headers-}" ;;
            *) continue ;;   # linux-libc-dev -> restore_libc_dev
        esac
        if [ -n "$only" ] && [ "$v" != "$only" ]; then continue; fi
        if [ "$v" = "$running" ]; then SKIPPED_RUNNING=true; continue; fi
        PURGE_PKGS+=("$p")
        if [ -z "${seen[$v]:-}" ]; then seen[$v]=1; PURGE_VERS+=("$v"); fi
    done < <(custom_packages)

    # Verwaiste Verzeichnisse: kein Kernel-Image mehr und keinem Paket zugeordnet
    for d in /lib/modules/* /usr/lib/debug/lib/modules/* /usr/src/linux-headers-*; do
        [ -d "$d" ] || continue
        v="${d##*/}"; v="${v#linux-headers-}"
        valid_release "$v" || continue
        if [ -n "$only" ] && [ "$v" != "$only" ]; then continue; fi
        if [ "$v" = "$running" ] || [ -e "/boot/vmlinuz-$v" ] || [ -n "${seen[$v]:-}" ]; then continue; fi
        path_owned "$d" && continue
        seen[$v]=1; PURGE_VERS+=("$v")
    done
}

# bindeb-pkg baut auch linux-libc-dev. Frühere Skript-Versionen haben damit das
# Distributions-Paket überschrieben - hier wird es wiederhergestellt.
restore_libc_dev() {
    local src cand
    src=$(dpkg-query -W -f '${source:Package}' linux-libc-dev 2>/dev/null || true)
    [ "$src" = "linux-upstream" ] || return 0
    cand=$(apt-cache madison linux-libc-dev 2>/dev/null | awk -F'|' '{ gsub(/ /, "", $2); print $2 }' | sort -V | tail -n 1 || true)
    if [ -z "$cand" ]; then
        err "linux-libc-dev stammt aus einem Custom-Build, aber im Repository wurde keine Version gefunden." "linux-libc-dev comes from a custom build, but no repository version was found."
        return 0
    fi
    info "Stelle das linux-libc-dev der Distribution wieder her ($cand)..." "Restoring the distribution's linux-libc-dev ($cand)..."
    run sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --allow-downgrades "linux-libc-dev=$cand" \
        || err "linux-libc-dev konnte nicht wiederhergestellt werden." "Could not restore linux-libc-dev."
}

# Reste früherer Skript-Versionen, die direkt in ~/Downloads gebaut haben
clean_legacy_artifacts() {
    local f found=false
    shopt -s nullglob
    for f in "$CPATH"/linux-[0-9]*; do
        if [ -d "$f" ] && [ -f "$f/Kconfig" ] && [ -f "$f/$BUILDDEB_FILE" ]; then
            found=true; run rm -rf -- "$f"
        elif [ -f "$f" ] && [[ $f == *.tar.xz || $f == *.tar.gz ]]; then
            found=true; run rm -f -- "$f"
        fi
    done
    for f in "$CPATH"/linux-upstream_*.buildinfo "$CPATH"/linux-upstream_*.changes \
             "$CPATH"/linux-image-*"$LOCALVER"*.deb "$CPATH"/linux-headers-*"$LOCALVER"*.deb \
             "$CPATH"/linux-libc-dev_*.deb; do
        found=true; run rm -f -- "$f"
    done
    shopt -u nullglob
    if [ "$found" = true ] && [ "$DRY_RUN" = false ]; then
        ok "Alte Build-Reste in $CPATH entfernt." "Removed old build leftovers in $CPATH."
    fi
}

purge_collected() {
    local v p
    if [ "${#PURGE_PKGS[@]}" -eq 0 ] && [ "${#PURGE_VERS[@]}" -eq 0 ]; then
        ok "Keine zu löschenden Custom-Kernel gefunden." "No custom kernels to delete."
        return 0
    fi
    say "Wird entfernt: ${PURGE_VERS[*]}" "Removing: ${PURGE_VERS[*]}"
    if [ "${#PURGE_PKGS[@]}" -gt 0 ]; then
        run sudo env DEBIAN_FRONTEND=noninteractive apt-get purge -y "${PURGE_PKGS[@]}"
    fi
    for v in "${PURGE_VERS[@]}"; do
        valid_release "$v" || continue
        for p in "/lib/modules/$v" "/usr/lib/debug/lib/modules/$v" "/usr/src/linux-headers-$v" \
                 "/var/lib/initramfs-tools/$v" "/boot/vmlinuz-$v" "/boot/initrd.img-$v" \
                 "/boot/System.map-$v" "/boot/config-$v"; do
            if [ -e "$p" ] || [ "$DRY_RUN" = true ]; then run sudo rm -rf -- "$p"; fi
        done
    done
    run sudo update-grub
}

purge_old_custom_kernels() {
    info "Bereinige alte Custom-Kernel-Reste aus dem System..." "Cleaning up old custom kernel leftovers..."
    collect_purge_targets
    if [ "$SKIPPED_RUNNING" = true ]; then
        info "Überspringe den aktiv geladenen Kernel $(uname -r)." "Skipping the running kernel $(uname -r)."
    fi
    purge_collected
    restore_libc_dev
    clean_legacy_artifacts
    ok "System-Bereinigung abgeschlossen." "System cleanup finished."
}

remove_single_kernel() {
    local v="$REMOVE_VERSION"
    valid_release "$v" || die "Ungültige Version: $v" "Invalid version: $v"
    [ "$v" != "$(uname -r)" ] || die "Der laufende Kernel kann nicht entfernt werden." "The running kernel cannot be removed."
    if [ -e "/boot/vmlinuz-$v" ] && ! is_custom_kernel "$v"; then
        die "$v ist ein Distributions-Kernel und wird nicht angefasst." "$v is a distribution kernel and will not be touched."
    fi
    start_sudo
    collect_purge_targets "$v"
    purge_collected
}

# ==============================================================================
# SICHERHEITS-NEUSTART
# ==============================================================================

pending_resume() { [ -f "$AUTOSTART_FILE" ] || [ -f "$RESUME_ARGS_FILE" ]; }

grub_next_entry_set() {
    command -v grub-editenv >/dev/null 2>&1 || return 1
    grub-editenv "$GRUB_ENV" list 2>/dev/null | grep -q '^next_entry=.'
}

cancel_pending_resume() {
    run rm -f "$AUTOSTART_FILE" "$RESUME_ARGS_FILE" "$RESUME_UI_FILE"
    if grub_next_entry_set; then
        run sudo grub-editenv "$GRUB_ENV" unset next_entry || true
    fi
}

launch_in_terminal() { # $@ = Kommando
    local hold
    hold=$(L "Drücke Enter zum Schließen..." "Press Enter to close...")
    local wrap=(bash -c '"$@"; echo; read -r -p "$0" _' "$hold" "$@")
    if command -v x-terminal-emulator >/dev/null 2>&1; then exec x-terminal-emulator -e "${wrap[@]}"
    elif command -v gnome-terminal >/dev/null 2>&1; then exec gnome-terminal -- "${wrap[@]}"
    elif command -v konsole >/dev/null 2>&1; then exec konsole -e "${wrap[@]}"
    elif command -v xterm >/dev/null 2>&1; then exec xterm -e "${wrap[@]}"
    fi
    command -v notify-send >/dev/null 2>&1 && notify-send "Kernel Upgrade" \
        "$(L "Kein Terminal gefunden. Bitte manuell fortsetzen: kernel_upgrade --purge-custom" "No terminal found. Please continue manually: kernel_upgrade --purge-custom")"
    exit 1
}

# Wird nach dem Neustart vom Autostart-Eintrag aufgerufen. Der Eintrag löscht
# sich als Erstes selbst, damit er garantiert nur ein einziges Mal läuft.
autostart_resume() {
    local args=() ui="terminal"
    if [ -f "$RESUME_ARGS_FILE" ]; then mapfile -t args < "$RESUME_ARGS_FILE"; fi
    if [ -f "$RESUME_UI_FILE" ]; then ui=$(cat "$RESUME_UI_FILE"); fi
    rm -f "$AUTOSTART_FILE" "$RESUME_ARGS_FILE" "$RESUME_UI_FILE"
    [ "${#args[@]}" -gt 0 ] || exit 0
    sleep 3
    if [ "$ui" = "gui" ] && [ -x "$SELF_DIR/$GUI_NAME" ]; then
        exec "$SELF_DIR/$GUI_NAME" --resume -- "${args[@]}"
    fi
    launch_in_terminal "$SELF" "${args[@]}"
}

handle_resume() {
    info "Setze Kernel-Upgrade nach Neustart fort..." "Resuming kernel upgrade after reboot..."
    run rm -f "$AUTOSTART_FILE" "$RESUME_ARGS_FILE" "$RESUME_UI_FILE"
    if is_custom_kernel "$(uname -r)"; then
        err "Achtung: Das System läuft weiterhin im Custom-Kernel $(uname -r). Dieser wird nicht entfernt." \
            "Warning: the system is still running the custom kernel $(uname -r). It will not be removed."
    fi
    purge_old_custom_kernels
}

handle_one_time_reboot() {
    local target entry i args=() desktop_exec
    info "Sicherheits-Boot: Es läuft ein Custom-Kernel." "Safety boot: a custom kernel is running."
    info "Das System startet einmalig in den offiziellen Distributions-Kernel, bereinigt alte Custom-Kernel und setzt den Build nach dem Login automatisch fort." \
         "The system reboots once into the official distribution kernel, removes old custom kernels and resumes the build automatically after login."
    info "(Mit --no-reboot lässt sich der Neustart überspringen.)" "(Use --no-reboot to skip the reboot.)"

    target=$(newest_stock_kernel)
    [ -n "$target" ] || die "Fehler: Kein offizieller Distributions-Kernel in /boot gefunden!" "Error: no official distribution kernel found in /boot!"
    entry=$(find_grub_entry "$target")
    if [ -z "$entry" ] && [ "$DRY_RUN" = false ]; then
        die "Fehler: Kein GRUB-Eintrag für $target in $GRUB_CFG gefunden!" "Error: no GRUB entry for $target found in $GRUB_CFG!"
    fi
    say "Gewählter Kernel für Reboot: $target" "Selected kernel for reboot: $target"
    say "GRUB-Eintrag: ${entry:-?}" "GRUB entry: ${entry:-?}"

    args=(--resumed --purge-custom)
    [ -z "$MANUAL_KERNEL_VERSION" ] || args+=(--kernelversion "$MANUAL_KERNEL_VERSION")
    [ "$ASSUME_YES" = false ] || args+=(--yes)
    [ "$WITH_DBG" = false ] || args+=(--with-dbg)
    [ "$KEEP_SOURCE" = false ] || args+=(--keep-source)
    [ "$WANT_AUTOSIGN" = true ] || args+=(--no-autosign)
    [ "$CPUCORES" = "$(nproc)" ] || args+=(--jobs "$CPUCORES")

    if [ "$DRY_RUN" = true ]; then
        run grub-reboot "$entry"
        run systemctl reboot
        say "Nach dem Neustart: kernel_upgrade ${args[*]}" "After reboot: kernel_upgrade ${args[*]}"
        return 0
    fi

    mkdir -p "$STATE_DIR" "$(dirname "$AUTOSTART_FILE")"
    printf '%s\n' "${args[@]}" > "$RESUME_ARGS_FILE"
    if [ "$GUI_MODE" = 1 ]; then echo gui > "$RESUME_UI_FILE"; else echo terminal > "$RESUME_UI_FILE"; fi
    desktop_exec="${SELF//\\/\\\\}"; desktop_exec="${desktop_exec//\"/\\\"}"
    cat > "$AUTOSTART_FILE" <<EOF
[Desktop Entry]
Type=Application
Name=Kernel Upgrade Resume
Exec="$desktop_exec" --autostart-resume
Icon=$ICON_NAME
Terminal=false
X-GNOME-Autostart-enabled=true
EOF

    # Ab hier ist der Neustart "scharf" - bei Abbruch alles wieder zurücknehmen
    trap 'echo; cancel_pending_resume; err "Neustart abgebrochen - alles zurückgesetzt." "Reboot cancelled - everything reverted."; exit 130' INT TERM
    sudo grub-reboot "$entry"

    marker "reboot 10"
    echo ""
    for i in {10..1}; do
        printf '\r%b%s%b  ' "$YELLOW" "$(L "Neustart in $i Sekunden... (STRG+C zum Abbrechen)" "Rebooting in $i seconds... (press CTRL+C to abort)")" "$NC"
        sleep 1
    done
    trap - INT TERM
    echo ""
    ok "Neustart wird jetzt durchgeführt..." "Rebooting now..."
    sudo systemctl reboot
}

# ==============================================================================
# SECURE BOOT / SIGNIERUNG
# ==============================================================================

is_efi() { [ -d /sys/firmware/efi ]; }

sys_keys_present() { sudo test -f "$SYS_MOK_DIR/MOK.priv" && sudo test -f "$SYS_MOK_DIR/MOK.pem"; }

write_mokconfig() {
    cat > "$1" <<'EOF'
HOME                    = .
[ req ]
distinguished_name      = req_distinguished_name
x509_extensions         = v3
string_mask             = utf8only
prompt                  = no

[ req_distinguished_name ]
countryName             = EN
stateOrProvinceName     = NA
localityName            = emptyland
0.organizationName      = empty
commonName              = Secure Boot Signing Key
emailAddress            = empty@nothing.nomail

[ v3 ]
subjectKeyIdentifier    = hash
authorityKeyIdentifier  = keyid:always,issuer
basicConstraints        = critical,CA:FALSE
extendedKeyUsage        = codeSigning,1.3.6.1.4.1.311.10.3.6
nsComment               = "OpenSSL Generated Certificate"
EOF
}

manage_keys() {
    local state
    mkdir -p "$USER_MOK_DIR"
    chmod 700 "$USER_MOK_DIR"
    info "Prüfe MOK Schlüssel..." "Checking MOK keys..."

    if [ -f "$MOK_PRIV" ] && [ -f "$MOK_PEM" ]; then
        [ -f "$MOK_DER" ] || openssl x509 -in "$MOK_PEM" -outform DER -out "$MOK_DER"
    elif sys_keys_present; then
        : # Systemschlüssel sind vorhanden - keine neuen erzeugen
    else
        ask_yn "$(L "Keine Keys gefunden. Neue UEFI-Keys generieren?" "No keys found. Generate new UEFI keys?")" y \
            || die "Abgebrochen." "Aborted."
        write_mokconfig "$USER_MOK_DIR/mokconfig.cnf"
        (umask 077; openssl req -config "$USER_MOK_DIR/mokconfig.cnf" -new -x509 -newkey rsa:2048 -nodes -days 36500 \
            -outform DER -keyout "$MOK_PRIV" -out "$MOK_DER")
        openssl x509 -in "$MOK_DER" -inform DER -outform PEM -out "$MOK_PEM"
    fi

    if [ -f "$MOK_PRIV" ] && [ -f "$MOK_PEM" ]; then
        chmod 600 "$MOK_PRIV"
        sudo install -d -m 755 "$SYS_MOK_DIR"
        sudo install -m 600 "$MOK_PRIV" "$SYS_MOK_DIR/MOK.priv"
        sudo install -m 644 "$MOK_PEM" "$SYS_MOK_DIR/MOK.pem"
        sudo install -m 644 "$MOK_DER" "$SYS_MOK_DIR/MOK.der"
    elif ! sudo test -f "$SYS_MOK_DIR/MOK.der"; then
        sudo openssl x509 -in "$SYS_MOK_DIR/MOK.pem" -outform DER -out "$SYS_MOK_DIR/MOK.der"
    fi

    # Ist der Schlüssel im Firmware-Schlüsselbund registriert?
    if is_efi && command -v mokutil >/dev/null 2>&1; then
        state=$(mokutil --test-key "$SYS_MOK_DIR/MOK.der" 2>&1 || true)
        if grep -qi 'already enrolled' <<<"$state"; then
            ok "MOK-Schlüssel ist registriert." "MOK key is enrolled."
        elif grep -qi 'enrollment request' <<<"$state"; then
            MOK_PENDING=true
        else
            info "MOK-Schlüssel ist noch nicht registriert. Bitte jetzt ein Einmal-Passwort vergeben:" "MOK key is not enrolled yet. Please set a one-time password now:"
            if sudo mokutil --import "$SYS_MOK_DIR/MOK.der"; then
                MOK_PENDING=true
            else
                err "mokutil --import ist fehlgeschlagen." "mokutil --import failed."
            fi
        fi
    fi
}

install_autosign_hook() {
    local tmp
    tmp=$(mktemp)
    cat > "$tmp" <<EOF
#!/bin/bash
# $AUTOSIGN_MARKER
# Signiert frisch installierte Kernel-Images mit dem lokalen MOK (Secure Boot).
KEY="$SYS_MOK_DIR/MOK.priv"
CERT="$SYS_MOK_DIR/MOK.pem"
EOF
    cat >> "$tmp" <<'EOF'

command -v sbsign >/dev/null 2>&1 && command -v sbverify >/dev/null 2>&1 || exit 0
if [ ! -r "$KEY" ] || [ ! -r "$CERT" ]; then
    echo "sign_kernel_images: MOK key not found, skipping." >&2
    exit 0
fi

if [ -n "${1:-}" ]; then
    images=("${2:-/boot/vmlinuz-$1}")
else
    images=(/boot/vmlinuz-*)
fi

for image in "${images[@]}"; do
    [ -f "$image" ] || continue
    # Bereits signierte Images (z.B. Distributions-Kernel) bleiben unangetastet
    if [[ "$(sbverify --list "$image" 2>&1)" != *"No signature table present"* ]]; then
        continue
    fi
    if sbsign --key "$KEY" --cert "$CERT" --output "$image.signed" "$image" >/dev/null 2>&1; then
        mv -f "$image.signed" "$image"
        echo "sign_kernel_images: signed $image"
    else
        rm -f "$image.signed"
        echo "sign_kernel_images: could not sign $image" >&2
    fi
done
exit 0
EOF
    sudo install -D -m 755 "$tmp" "$AUTOSIGN_PATH"
    rm -f "$tmp"
    ok "Autosign-Script unter $AUTOSIGN_PATH konfiguriert." "Autosign script configured at $AUTOSIGN_PATH."
}

autosign_current() { [ -f "$AUTOSIGN_PATH" ] && grep -qF "$AUTOSIGN_MARKER" "$AUTOSIGN_PATH" 2>/dev/null; }

manage_autosign() { # $1 = "force" bei --installautosign
    if [ "${1:-}" = force ]; then
        install_autosign_hook
    elif [ -f "$AUTOSIGN_PATH" ]; then
        if ! autosign_current; then
            info "Veralteter Autosign-Hook gefunden - wird aktualisiert." "Outdated autosign hook found - updating."
            install_autosign_hook
        fi
    elif [ "$WANT_AUTOSIGN" = true ] && ask_yn "$(L "Soll das Autosign-Script installiert werden?" "Should the autosign script be installed?")" y; then
        install_autosign_hook
    fi
}

uninstall_autosign() {
    if [ -f "$AUTOSIGN_PATH" ]; then sudo rm -v "$AUTOSIGN_PATH"; fi
    if ask_yn "$(L "Auch die System-Schlüssel in $SYS_MOK_DIR löschen?" "Delete system keys in $SYS_MOK_DIR too?")" n; then
        sudo rm -rf "$SYS_MOK_DIR"
    fi
}

sign_kernel() { # $1 = Kernel-Release
    local img="/boot/vmlinuz-$1"
    sudo test -f "$img" || die "Kernel-Image $img nicht gefunden." "Kernel image $img not found."
    command -v sbsign >/dev/null 2>&1 || sudo apt-get install -y sbsigntool >/dev/null
    if sudo sbverify --cert "$SYS_MOK_DIR/MOK.pem" "$img" >/dev/null 2>&1; then
        ok "$img ist bereits mit dem MOK signiert." "$img is already signed with the MOK."
        return 0
    fi
    sudo sbsign --key "$SYS_MOK_DIR/MOK.priv" --cert "$SYS_MOK_DIR/MOK.pem" --output "$img.signed" "$img"
    sudo mv -f "$img.signed" "$img"
    ok "$img signiert." "$img signed."
}

manual_sign() {
    local v="$SIGN_VERSION" list=() i choice
    manage_keys
    if [ -z "$v" ]; then
        mapfile -t list < <(installed_kernels)
        [ "${#list[@]}" -gt 0 ] || die "Keine Kernel in /boot gefunden." "No kernels found in /boot."
        for i in "${!list[@]}"; do echo "  [$((i+1))] ${list[$i]}"; done
        read -r -p "$(L "Auswahl oder Version" "Selection or version"): " choice
        if [[ $choice =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#list[@]}" ]; then
            v="${list[$((choice-1))]}"
        else
            v="$choice"
        fi
    fi
    valid_release "$v" || die "Ungültige Version: $v" "Invalid version: $v"
    sign_kernel "$v"
}

