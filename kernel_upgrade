    case "$prev" in
        --kernelversion) COMPREPLY=( $(compgen -W "stable longterm mainline" -- "$cur") ); return 0 ;;
        --remove|--signonly) COMPREPLY=( $(compgen -W "$(ls /boot/vmlinuz-* 2>/dev/null | sed 's|/boot/vmlinuz-||')" -- "$cur") ); return 0 ;;
    esac
    if [[ ${cur} == -* ]] ; then
        COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
        return 0
    fi
}
complete -F _kernel_upgrade_completions kernel_upgrade
EOF
    if ! cmp -s "$tmp" "$COMPLETION_PATH"; then
        sudo install -D -m 644 "$tmp" "$COMPLETION_PATH" || true
    fi
