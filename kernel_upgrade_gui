    def _rebuild_kernel_rows(self):
        for group, row in self._kernel_rows:
            group.remove(row)
        self._kernel_rows = []

        for kernel in self.status.get("kernels", []):
            version = kernel["version"]
            kind = T("Custom-Build", "Custom build") if kernel["custom"] else T("Distribution", "Distribution")
            row = Adw.ActionRow(title=version, subtitle=kind + (T(" · aktiv", " · running") if kernel["running"] else ""))
            row.add_prefix(Gtk.Image(icon_name="emblem-ok-symbolic" if kernel["running"] else "application-x-firmware-symbolic"))
            if kernel["custom"]:
                sign = self._row_button("document-edit-symbolic", T("Mit MOK signieren", "Sign with MOK"))
                sign.connect("clicked", lambda _b, v=version: self.run_task(
                    T(f"Signiere {v}", f"Signing {v}"), ["--signonly", v, "--yes"]))
                row.add_suffix(sign)
                if not kernel["running"]:
                    remove = self._row_button("user-trash-symbolic", T("Entfernen", "Remove"))
                    remove.add_css_class("error")
                    remove.connect("clicked", lambda _b, v=version: self._confirm_remove(v))
                    row.add_suffix(remove)
            self.kernel_group.add(row)
            self._kernel_rows.append((self.kernel_group, row))

        leftovers = self.status.get("leftovers", [])
        self.leftover_group.set_visible(bool(leftovers))
        for version in leftovers:
            row = Adw.ActionRow(title=version, subtitle=T("Kein Kernel-Image mehr vorhanden", "No kernel image present any more"))
            row.add_prefix(Gtk.Image(icon_name="dialog-warning-symbolic"))
            remove = self._row_button("user-trash-symbolic", T("Entfernen", "Remove"))
            remove.connect("clicked", lambda _b, v=version: self.run_task(
                T(f"Entferne Reste von {v}", f"Removing leftovers of {v}"), ["--remove", v]))
            row.add_suffix(remove)
            self.leftover_group.add(row)
            self._kernel_rows.append((self.leftover_group, row))

