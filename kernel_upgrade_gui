                      margin_top=18, margin_bottom=18, margin_start=18, margin_end=18)
        top = Gtk.Box(spacing=12)
        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, hexpand=True)
        self.stage_label = Gtk.Label(label=T("Bereit", "Ready"), xalign=0, ellipsize=Pango.EllipsizeMode.END)
        self.stage_label.add_css_class("title-4")
        self.progress = Gtk.ProgressBar()
        labels.append(self.stage_label)
        labels.append(self.progress)
        top.append(labels)
        self.cancel_button = Gtk.Button(label=T("Abbrechen", "Cancel"), valign=Gtk.Align.CENTER, sensitive=False)
        self.cancel_button.add_css_class("destructive-action")
        self.cancel_button.connect("clicked", lambda *_: self.runner.interrupt())
        top.append(self.cancel_button)
        box.append(top)

        self.log = LogView()
        box.append(self.log)

        bottom = Gtk.Box(spacing=8)
        self.input = Gtk.Entry(hexpand=True, sensitive=False)
        self.input.connect("activate", self._on_send)
        self.send_button = Gtk.Button(label=T("Senden", "Send"), sensitive=False)
        self.send_button.connect("clicked", self._on_send)
        bottom.append(self.input)
        bottom.append(self.send_button)
        box.append(bottom)
        self._on_echo(True)
        return box

    def _on_send(self, *_):
        self.runner.send_line(self.input.get_text())
        self.input.set_text("")

    def _on_echo(self, echo):
        """Echo off means a program (sudo, mokutil) is waiting for a password."""
        self.input.set_visibility(echo)
        if echo:
            self.input.remove_css_class("ku-password")
            self.input.set_placeholder_text(T("Eingabe an das Skript senden …", "Send input to the script …"))
        else:
            self.input.add_css_class("ku-password")
            self.input.set_placeholder_text(T("Passwort eingeben und Enter drücken", "Enter password and press Enter"))
            self.stack.set_visible_child_name("log")
            self.input.grab_focus()
            self.present()

    # ------------------------------------------------------------ data flow
    def refresh(self):
        try:
            out = subprocess.run([self.script, "--status-json"], capture_output=True, text=True, timeout=30).stdout
            self.status = json.loads(out)
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            self.toast(T(f"Status konnte nicht gelesen werden: {exc}", f"Could not read status: {exc}"))
            return
        st = self.status

        sb = st.get("secure_boot")
        self._set_status(self.sb_row, *{
            "enabled": (T("Aktiv", "Enabled"), "success"),
            "disabled": (T("Deaktiviert", "Disabled"), None),
            "unsupported": (T("Kein UEFI", "No UEFI"), None),
        }.get(sb, (T("Unbekannt", "Unknown"), None)))
        self._set_status(self.mok_row, *{
            "enrolled": (T("Registriert", "Enrolled"), "success"),
            "pending": (T("Registrierung ausstehend", "Enrollment pending"), "warning"),
            "present": (T("Vorhanden, nicht registriert", "Present, not enrolled"), "warning"),
        }.get(st.get("mok"), (T("Nicht vorhanden", "Missing"), "warning" if sb == "enabled" else None)))
        hook = st.get("autosign")
        self._set_status(self.hook_row, *{
            "current": (T("Installiert", "Installed"), "success"),
            "outdated": (T("Veraltet", "Outdated"), "warning"),
        }.get(hook, (T("Nicht installiert", "Not installed"), None)))
        self.hook_button.set_visible(hook != "current")
        self.hook_button.set_label(T("Aktualisieren", "Update") if hook == "outdated" else T("Installieren", "Install"))
        self.autosign_row.set_visible(hook == "none" and sb != "unsupported")
        free = st.get("free_gb", 0)
        self._set_status(self.disk_row, f"{free} GB", "warning" if free < 45 else "success", st.get("work_dir", ""))
        self.libc_row.set_visible(bool(st.get("libc_dev_custom")))
        self._set_status(self.libc_row, T("Aus Custom-Build", "From custom build"), "warning",
                         T("Wird bei der Bereinigung auf die Distributions-Version zurückgesetzt.",
                           "Will be restored to the distribution version during cleanup."))

        self.reboot_row.set_visible(bool(st.get("running_custom")))
        self.jobs_row.set_range(1, st.get("cores", 1))
        self._sync_options()
        self._rebuild_kernel_rows()
        self._update_hero()
        self._update_banner()

    def _sync_options(self):
        rebooting = self.reboot_row.get_visible() and self.reboot_row.get_active()
        self.purge_row.set_sensitive(not rebooting)
        if rebooting:
            self.purge_row.set_active(True)

    def _update_banner(self):
        if self._mok_pending or self.status.get("mok") == "pending":
            self.banner.set_title(T("Beim nächsten Neustart im blauen MOK-Manager „Enroll MOK“ wählen und das Einmal-Passwort eingeben.",
                                    "On the next reboot choose “Enroll MOK” in the blue MOK manager and enter the one-time password."))
            self.banner.set_button_label(None)
            self.banner.set_revealed(True)
        elif self.status.get("pending_resume") and not self.runner.running:
            self.banner.set_title(T("Ein abgebrochener Neustart-Vorgang ist noch scharf (Autostart-Eintrag und GRUB-Einmalstart).",
                                    "An aborted reboot sequence is still armed (autostart entry and one-time GRUB boot)."))
            self.banner.set_button_label(T("Jetzt bereinigen", "Clean up now"))
            self.banner.set_revealed(True)
        else:
            self.banner.set_revealed(False)

    def _on_banner_clicked(self, *_):
        self._on_cleanup_clicked()

    def _fetch_releases(self):
        def worker():
            # right after login the network may not be up yet: retry for up to a minute
            data, deadline, announced = None, time.monotonic() + NET_WAIT, False
            while data is None:
                try:
                    with urllib.request.urlopen(RELEASES_URL, timeout=10) as resp:
                        data = json.load(resp)
                except (OSError, ValueError):
                    if time.monotonic() >= deadline:
                        break
                    if not announced:
                        announced = True
                        GLib.idle_add(self.version_row.set_subtitle,
                                      T("Warte auf Netzwerkverbindung …", "Waiting for network connection …"))
                    time.sleep(3)
            GLib.idle_add(self._set_releases, data)
        threading.Thread(target=worker, daemon=True).start()

    def _set_releases(self, data):
        labels, self.version_values = [], []
        if data:
            self.latest_stable = data.get("latest_stable", {}).get("version")
            self.releases = [r for r in data.get("releases", [])
                             if r.get("moniker") in ("stable", "longterm", "mainline")]
            self.releases.sort(key=lambda r: r["version"] != self.latest_stable)
            for rel in self.releases:
                extra = " · EOL" if rel.get("iseol") else ""
                labels.append(f"{rel['version']}   ·   {rel['moniker']}{extra}")
                self.version_values.append(rel["version"])
            self.version_row.set_subtitle("kernel.org")
        else:
            labels.append(T("Neueste stabile Version (automatisch)", "Latest stable version (automatic)"))
            self.version_values.append("stable")
            self.version_row.set_subtitle(T("kernel.org nicht erreichbar", "kernel.org not reachable"))
        labels.append(T("Eigene Version …", "Custom version …"))
        self.version_values.append(None)
        self.version_row.set_model(Gtk.StringList.new(labels))
        self.version_row.set_selected(0)
        self._update_hero()
        return GLib.SOURCE_REMOVE

    def selected_version(self):
        idx = self.version_row.get_selected()
        if not self.version_values or idx >= len(self.version_values):
            return None
        value = self.version_values[idx]
        self.custom_row.set_visible(value is None)
        return self.custom_row.get_text().strip() if value is None else value

    def _installed(self, version):
        release = expected_release(version, self.status.get("localversion", "-waydroid"))
        return any(k["version"] == release for k in self.status.get("kernels", []))

    def _update_hero(self):
        st = self.status
        self.hero_kernel.set_label(st.get("running", "?"))
        child = self.hero_chips.get_first_child()
        while child:
            self.hero_chips.remove(child)
            child = self.hero_chips.get_first_child()

        def chip(text, cls=None):
            label = Gtk.Label(label=text)
            label.add_css_class("ku-chip")
            if cls:
                label.add_css_class(cls)
            self.hero_chips.append(label)

        chip(T("Custom-Build", "Custom build") if st.get("running_custom") else T("Distributions-Kernel", "Distribution kernel"))
        if st.get("secure_boot") == "enabled":
            chip("Secure Boot", "good")
        latest = self.latest_stable
        if latest:
            if self._installed(latest):
                chip(T("Aktuell", "Up to date"), "good")
                self.hero_latest.set_label(T(f"Die neueste stabile Version {latest} ist bereits installiert.",
                                             f"The latest stable version {latest} is already installed."))
            else:
                chip(T("Update verfügbar", "Update available"), "warn")
                self.hero_latest.set_label(T(f"Neueste stabile Version auf kernel.org: {latest}",
                                             f"Latest stable version on kernel.org: {latest}"))
        else:
            self.hero_latest.set_label("")

        version = self.selected_version()
        valid = bool(version) and (version == "stable" or re.fullmatch(r"\d+\.\d+(\.\d+)?(-rc\d+)?", version))
        if not valid:
            self.go_button.set_label(T("Version wählen", "Choose a version"))
        elif version != "stable" and self._installed(version):
            self.go_button.set_label(T(f"{version} neu bauen", f"Rebuild {version}"))
        elif version == "stable":
            self.go_button.set_label(T("Bauen & installieren", "Build & install"))
        else:
            self.go_button.set_label(T(f"{version} bauen & installieren", f"Build & install {version}"))
        self._go_valid = bool(valid)
        self.go_button.set_sensitive(self._go_valid and not self.runner.running)

    # -------------------------------------------------------------- actions
    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text, timeout=5))

    def _confirm(self, heading, body, label, callback, destructive=False):
        dialog = Adw.AlertDialog(heading=heading, body=body)
        dialog.add_response("cancel", T("Abbrechen", "Cancel"))
        dialog.add_response("ok", label)
        dialog.set_response_appearance("ok", Adw.ResponseAppearance.DESTRUCTIVE if destructive
                                       else Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _d, response: callback() if response == "ok" else None)
        dialog.present(self)

    def _on_build_clicked(self, *_):
        version = self.selected_version()
        args = ["--yes", "--kernelversion", version, "--jobs", str(int(self.jobs_row.get_value()))]
        if self.dbg_row.get_active():
            args.append("--with-dbg")
        if self.keep_row.get_active():
            args.append("--keep-source")
        if self.autosign_row.get_visible() and not self.autosign_row.get_active():
            args.append("--no-autosign")
        title = T(f"Kernel {version} bauen", f"Building kernel {version}")

        if self.status.get("running_custom") and self.reboot_row.get_active():
            stock = self.status.get("stock_kernel") or "?"
            self._confirm(
                T("Der Rechner wird neu gestartet", "The computer is going to reboot"),
                T(f"Nach 10 Sekunden Countdown startet das System einmalig in den Distributions-Kernel {stock}. "
                  "Nach dem Login öffnet sich diese App wieder, entfernt die alten Custom-Kernel und baut weiter.\n\n"
                  "Bitte vorher alle offenen Dokumente speichern.",
                  f"After a 10 second countdown the system reboots once into the distribution kernel {stock}. "
                  "After login this app opens again, removes the old custom kernels and continues the build.\n\n"
                  "Please save all open documents first."),
                T("Neu starten & bauen", "Reboot & build"),
                lambda: self.run_task(title, args), destructive=True)
            return
        if self.status.get("running_custom"):
            args.append("--no-reboot")
        if self.purge_row.get_active():
            args.append("--purge-custom")
        self.run_task(title, args)

    def _on_cleanup_clicked(self, *_):
        self._confirm(
            T("Alles bereinigen?", "Clean up everything?"),
            T("Entfernt alle Custom-Kernel außer dem laufenden, verwaiste Module/Header, alte Build-Reste "
              "und nimmt einen abgebrochenen Neustart-Vorgang zurück. Distributions-Kernel bleiben unberührt.",
              "Removes all custom kernels except the running one, orphaned modules/headers, old build leftovers "
              "and reverts an aborted reboot sequence. Distribution kernels stay untouched."),
            T("Bereinigen", "Clean up"),
            lambda: self.run_task(T("Bereinigung", "Cleanup"), ["--cleanup", "--yes"]), destructive=True)

    def _confirm_remove(self, version):
        self._confirm(
            T(f"Kernel {version} entfernen?", f"Remove kernel {version}?"),
            T("Kernel-Image, Module, Header und Debug-Symbole dieser Version werden gelöscht.",
              "Kernel image, modules, headers and debug symbols of this version will be deleted."),
            T("Entfernen", "Remove"),
            lambda: self.run_task(T(f"Entferne {version}", f"Removing {version}"), ["--remove", version]),
            destructive=True)

    def _start_resume(self, args):
        self.run_task(T("Fortsetzung nach Neustart", "Resuming after reboot"), args)
        return GLib.SOURCE_REMOVE

    def run_task(self, title, args):
        if self.runner.running:
            self.toast(T("Es läuft bereits ein Vorgang.", "A task is already running."))
            self.stack.set_visible_child_name("log")
            return
        self.task_title = title
        self._marker_tail = ""
        self.log.clear()
        self.log.feed(f"\x1b[1;36m$ kernel_upgrade {' '.join(args)}\x1b[0m\n")
        self.stage_label.set_label(title)
        self.progress.set_fraction(0)
        self.stack.set_visible_child_name("log")
        self._set_busy(True)
        env = dict(os.environ, KU_GUI="1", TERM="xterm-256color")
        try:
            self.runner.start([self.script, *args], env)
        except OSError as exc:
            self._set_busy(False)
            self.toast(str(exc))

    def _set_busy(self, busy):
        self.spinner.set_spinning(busy)
        self.cancel_button.set_sensitive(busy)
        self.input.set_sensitive(busy)
        self.send_button.set_sensitive(busy)
        self.busy_widgets = [w for w in self.busy_widgets if w.get_root() is not None or w is self.go_button]
        for widget in self.busy_widgets:
            widget.set_sensitive(not busy)
        if not busy:
            self.go_button.set_sensitive(getattr(self, "_go_valid", False))

    def _on_output(self, text):
        text = self._marker_tail + text
        self._marker_tail = ""
        while True:
            start = text.find("@@KU@@")
            if start < 0:
                break
            end = text.find("\n", start)
            if end < 0:
                self._marker_tail = text[start:]
                text = text[:start]
                break
            self._on_marker(text[start + 6:end].strip())
            text = text[:start] + text[end + 1:]
        if text:
            self.log.feed(text)

    def _on_marker(self, marker):
        kind, _, rest = marker.partition(" ")
        if kind == "stage":
            try:
                num, total, title = rest.split(" ", 2)
                self.progress.set_fraction((int(num) - 1) / int(total))
                self.stage_label.set_label(T(f"Schritt {num}/{total} · {title}", f"Step {num}/{total} · {title}"))
            except ValueError:
                pass
        elif kind == "reboot":
            self.stage_label.set_label(T("Neustart steht bevor …", "Reboot imminent …"))
        elif kind == "mok-pending":
            self._mok_pending = True

    def _on_exit(self, code):
        self._set_busy(False)
        if code == 0:
            self.progress.set_fraction(1)
            message = T(f"{self.task_title}: abgeschlossen", f"{self.task_title}: finished")
        else:
            message = T(f"{self.task_title}: fehlgeschlagen oder abgebrochen (Code {code})",
                        f"{self.task_title}: failed or cancelled (code {code})")
        self.stage_label.set_label(message)
        self.toast(message)
        if not self.is_active():
            note = Gio.Notification.new("Kernel Upgrade")
            note.set_body(message)
            self.get_application().send_notification("task", note)
        self.refresh()

    def _on_close_request(self, *_):
        if not self.runner.running:
            return False
        self._confirm(
            T("Vorgang läuft noch", "A task is still running"),
            T("Beim Schließen wird der laufende Vorgang abgebrochen.", "Closing will cancel the running task."),
            T("Abbrechen & schließen", "Cancel task & close"), self._force_close, destructive=True)
        return True

    def _force_close(self):
        self.runner.interrupt()
        self.runner.interrupt()
        self.destroy()


class KernelUpgradeApp(Adw.Application):
    def __init__(self, resume_args):
        super().__init__(application_id=APP_ID)
        self.resume_args = resume_args
        GLib.set_application_name("Kernel Upgrade")

    def do_startup(self):
        Adw.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        display = Gdk.Display.get_default()
        Gtk.StyleContext.add_provider_for_display(display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        assets = os.path.join(HERE, "assets")
        if os.path.isdir(assets):  # running straight from the repository
            Gtk.IconTheme.get_for_display(display).add_search_path(assets)

    def do_activate(self):
        window = self.props.active_window
        if window is None:
            script = find_script()
            if script is None:
                dialog = Adw.AlertDialog(
                    heading=T("kernel_upgrade nicht gefunden", "kernel_upgrade not found"),
                    body=T("Das Skript muss im selben Ordner wie die GUI oder im PATH liegen.",
                           "The script must be in the same folder as the GUI or in your PATH."))
                dialog.add_response("ok", "OK")
                placeholder = Adw.ApplicationWindow(application=self, default_width=420, default_height=160)
                dialog.connect("response", lambda *_: placeholder.destroy())
                placeholder.present()
                dialog.present(placeholder)
                return
            window = MainWindow(self, script, self.resume_args)
        window.present()


def main():
    resume_args = []
    if "--resume" in sys.argv:
        rest = sys.argv[sys.argv.index("--resume") + 1:]
        resume_args = rest[1:] if rest[:1] == ["--"] else rest
    return KernelUpgradeApp(resume_args).run(sys.argv[:1])


if __name__ == "__main__":
    sys.exit(main())
