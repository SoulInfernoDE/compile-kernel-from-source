        row = Adw.ActionRow(title=title)
        row.add_prefix(Gtk.Image(icon_name=icon))
        row.value = Gtk.Label(valign=Gtk.Align.CENTER)
        row.add_suffix(row.value)
        group.add(row)
        return row

    @staticmethod
    def _set_status(row, text, level=None, subtitle=""):
        row.value.set_label(text)
        for cls in ("success", "warning", "error", "dim-label"):
            row.value.remove_css_class(cls)
        row.value.add_css_class(level or "dim-label")
        row.set_subtitle(subtitle)

