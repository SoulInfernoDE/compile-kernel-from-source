def find_script():
    local = os.path.join(HERE, "kernel_upgrade")
    if os.access(local, os.X_OK):
        return local
    return shutil.which("kernel_upgrade")


def expected_release(version, localversion):
    """7.2 -> 7.2.0-waydroid, 7.3-rc6 -> 7.3.0-rc6-waydroid (same as the script)."""
    base, _, rc = version.partition("-")
    if re.fullmatch(r"\d+\.\d+", base):
        base += ".0"
    return base + (f"-{rc}" if rc else "") + localversion


