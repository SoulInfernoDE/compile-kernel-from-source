ANSI_COLORS = {
    30: "#6b7089", 31: "#ff6b6b", 32: "#4ade80", 33: "#fbbf24",
    34: "#7aa2f7", 35: "#c792ea", 36: "#22d3ee", 37: "#ffffff",
}
TOKEN_RE = re.compile(
    r"\x1b\[([0-9;?]*)([A-Za-z])"            # CSI sequence
    r"|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)"   # OSC sequence
    r"|\x1b[()][A-Za-z0-9]"                  # charset selection
    r"|[\r\n\x07\x08]")
PARTIAL_ESC_RE = re.compile(r"\x1b(\[[0-9;?]*)?$")
MAX_LOG_LINES = 8000


class LogView(Gtk.ScrolledWindow):
    """A tiny terminal renderer: colours, carriage returns and line limits."""

    def __init__(self):
        super().__init__(vexpand=True, hexpand=True)
        self.add_css_class("ku-logframe")
        self.set_overflow(Gtk.Overflow.HIDDEN)
        self.view = Gtk.TextView(editable=False, cursor_visible=False, monospace=True,
                                 wrap_mode=Gtk.WrapMode.WORD_CHAR)
        self.view.add_css_class("ku-log")
        self.set_child(self.view)
        self.buf = self.view.get_buffer()
        self.end_mark = self.buf.create_mark("end", self.buf.get_end_iter(), False)
        self.buf.create_tag("bold", weight=Pango.Weight.BOLD)
        for code, color in ANSI_COLORS.items():
            self.buf.create_tag(f"fg{code}", foreground=color)
        self._tags = []
        self._cr = False
        self._pending = ""
        self._scroll_queued = False

    def clear(self):
        self.buf.set_text("")
        self._tags, self._cr, self._pending = [], False, ""

    def feed(self, text):
        text = self._pending + text
        self._pending = ""
        partial = PARTIAL_ESC_RE.search(text)
        if partial:
            self._pending = text[partial.start():]
            text = text[:partial.start()]

        pos = 0
        for m in TOKEN_RE.finditer(text):
            if m.start() > pos:
                self._put(text[pos:m.start()])
            pos = m.end()
            tok = m.group(0)
            if tok == "\n":
                self._cr = False
                self.buf.insert(self.buf.get_end_iter(), "\n")
            elif tok == "\r":
                self._cr = True
            elif m.group(2) == "m":
                self._sgr(m.group(1))
        if pos < len(text):
            self._put(text[pos:])

        if self.buf.get_line_count() > MAX_LOG_LINES:
            start = self.buf.get_start_iter()
            cut = self.buf.get_iter_at_line(self.buf.get_line_count() - MAX_LOG_LINES + 500)[1]
            self.buf.delete(start, cut)
        if not self._scroll_queued:
            self._scroll_queued = True
            GLib.idle_add(self._scroll_to_end)

    def _put(self, text):
        end = self.buf.get_end_iter()
        if self._cr:  # a lone carriage return rewrites the current line (progress bars)
            self._cr = False
            start = self.buf.get_iter_at_line(end.get_line())[1]
            self.buf.delete(start, end)
            end = self.buf.get_end_iter()
        if self._tags:
            self.buf.insert_with_tags_by_name(end, text, *self._tags)
        else:
            self.buf.insert(end, text)

    def _sgr(self, params):
        for code in (int(p) if p.isdigit() else 0 for p in (params or "0").split(";")):
            if code == 0:
                self._tags = []
            elif code == 1:
                if "bold" not in self._tags:
                    self._tags.append("bold")
            elif code == 39:
                self._tags = [t for t in self._tags if not t.startswith("fg")]
            else:
                base = code - 60 if 90 <= code <= 97 else code
                if base in ANSI_COLORS:
                    self._tags = [t for t in self._tags if not t.startswith("fg")] + [f"fg{base}"]

    def _scroll_to_end(self):
        self._scroll_queued = False
        self.buf.move_mark(self.end_mark, self.buf.get_end_iter())
        self.view.scroll_mark_onscreen(self.end_mark)
        return GLib.SOURCE_REMOVE


class Runner:
    """Runs a command on its own pseudo terminal and reports output and exit."""

    def __init__(self, on_output, on_exit, on_echo):
        self.on_output, self.on_exit, self.on_echo = on_output, on_exit, on_echo
        self.proc = None
        self.master = -1
        self._decoder = None
        self._echo = True
        self._interrupts = 0

    @property
    def running(self):
        return self.proc is not None

    def start(self, argv, env):
        master, slave = os.openpty()
        fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", 40, 110, 0, 0))
        self.proc = subprocess.Popen(
            argv, stdin=slave, stdout=slave, stderr=slave, env=env, close_fds=True,
            start_new_session=True,
            preexec_fn=lambda: fcntl.ioctl(0, termios.TIOCSCTTY, 0))
        os.close(slave)
        os.set_blocking(master, False)
        self.master = master
        self._decoder = codecs.getincrementaldecoder("utf-8")("replace")
        self._echo = True
        self._interrupts = 0
        GLib.unix_fd_add_full(GLib.PRIORITY_DEFAULT, master,
                              GLib.IOCondition.IN | GLib.IOCondition.HUP, self._on_io)
        GLib.timeout_add(250, self._poll)

    def _read(self):
        try:
            data = os.read(self.master, 65536)
        except BlockingIOError:
            return True
        except OSError:
            return False
        if not data:
            return False
        self.on_output(self._decoder.decode(data))
        return True

    def _on_io(self, _fd, _cond):
        if self.master < 0:
            return GLib.SOURCE_REMOVE
        return GLib.SOURCE_CONTINUE if self._read() else GLib.SOURCE_REMOVE

    def _poll(self):
        if self.proc is None:
            return GLib.SOURCE_REMOVE
        code = self.proc.poll()
        if code is None:
            try:  # programs asking for a password switch the terminal echo off
                echo = bool(termios.tcgetattr(self.master)[3] & termios.ECHO)
            except termios.error:
                echo = True
            if echo != self._echo:
                self._echo = echo
                self.on_echo(echo)
            return GLib.SOURCE_CONTINUE
        while self._read():
            pass
        os.close(self.master)
        self.master, self.proc = -1, None
        self.on_echo(True)
        self.on_exit(code)
        return GLib.SOURCE_REMOVE

    def send_line(self, text):
        if self.running:
            os.write(self.master, (text + "\n").encode())

    def interrupt(self):
        """First Ctrl+C through the terminal (also reaches sudo children), then SIGTERM."""
        if not self.running:
            return
        self._interrupts += 1
        try:
            if self._interrupts == 1:
                os.write(self.master, b"\x03")
            else:
                os.killpg(self.proc.pid, signal.SIGTERM)
        except OSError:
            pass


